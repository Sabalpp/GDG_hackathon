# Copy the relevant settings into each service's local environment file.

# --- repository root .env.local (public, bundled into the browser) ---
# Firebase Hosting uses /api/v1 so requests stay same-origin.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- apps/api/.env (server-side only; never expose the key to the browser) ---
PORT=8080
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEOMETRY_BASE_URL=http://127.0.0.1:8000
PROJECT_STORE=memory

# --- services/geometry/.env (optional) ---
# ADAPT_DATA_DIR=/absolute/path/to/data
