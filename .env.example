# Copy the relevant block into each app's own env file. Never commit real values.

# --- apps/web/.env.local (public, bundled into the browser) ---
# Locally: point at Express. On Firebase Hosting: leave as /api/v1 so the
# Hosting rewrite forwards to the Cloud Run API on the same origin.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- apps/api/.env (server-only secrets) ---
PORT=8080
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
GEMINI_API_KEY=replace-me
GEMMA_MODEL=gemma-4-26b-a4b-it
GEOMETRY_BASE_URL=http://127.0.0.1:8000
PROJECT_STORE=memory

# --- services/geometry/.env (optional) ---
# Cloud Run supplies PORT; local uvicorn uses --port 8000.
# ADAPT_DATA_DIR=/absolute/path/to/data
